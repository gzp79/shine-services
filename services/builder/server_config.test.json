{
  "beforeLayers": [
    "file://../config/common.mock.json",
    "file://../config/common.test.json",
    "file://config/mock.json"
  ],
  "afterLayers": ["environment", "file?://../../temp/server_config.json"],

  "service": {
    "port": 7001
  },

  "builder": {
    "hub": {
      "heartbeat": 300,
      "sessionCheck": 2,
      "pingEnabled": true
    },
    "ws": {
      "limits": { "frames": { "burst": 1000, "perSecond": 1000 } }
    },
    "streams": {
      "chat": {
        "inbox": { "recoveryPollInterval": 1 }
      },
      "pixelMap": {
        "inbox": { "recoveryPollInterval": 1 }
      }
    }
  }
}
