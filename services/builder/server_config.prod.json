{
  "beforeLayers": [
    "file://../server_config.json",
    "azk://shine-keyvault.vault.azure.net/"
  ],
  "afterLayers": ["environment"],

  "service": {
    "port": 7001
  },

  "builder": {
    "hubHeartbeatSeconds": 300,
    "authCheckInterval": 60,
    "commandStream": {
      "kinds": {
        "chat": { "snapshotEvery": 50, "keepSnapshots": 5 }
      }
    },
    "ws": {
      "allowedHosts": ["^ws\\.scytta\\.com(:443)?$"]
    }
  }
}
