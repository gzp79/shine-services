{
  "beforeLayers": [
    "file://../config/common.mock.json",
    "file://config/mock.json",
    "file://../config/telemetry.local.json"
  ],
  "afterLayers": ["environment", "file?://../../temp/server_config.json"],

  "service": {
    "port": 8444,
    "tls": {
      "cert": "../../certificates/scytta.crt",
      "key": "../../certificates/scytta.key"
    }
  },

  "telemetry": {
    "defaultLevel": "info,shine_game=trace,shine_forge=trace,shine_infra=trace,shine_builder=debug,test_map=trace"
  },

  "builder": {
    "streams": {
      "chat": {
        "inboxRecoveryPollInterval": 60
      },
      "pixelMap": {
        "inboxRecoveryPollInterval": 60
      }
    }
  }
}
