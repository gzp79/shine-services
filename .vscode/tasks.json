{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "format",
      "type": "shell",
      "command": "cargo fmt",
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "clippy",
      "type": "shell",
      "command": "cargo clippy ${input:projects} --all-targets",
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "clippy wasm",
      "type": "shell",
      "command": "cargo clippy --target wasm32-unknown-unknown ${input:wasm-projects} --all-targets",
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "build",
      "type": "shell",
      "command": "cargo build --release ${input:projects} --all-targets",
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "build wasm",
      "type": "shell",
      "command": "cargo build --target wasm32-unknown-unknown --release ${input:wasm-projects} --all-targets",
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "test native",
      "type": "shell",
      "command": "cargo test ${input:projects}",
      "options": {
        "env": {
          "RUST_LOG": "warn",
          "RUST_BACKTRACE": "full",
          "SHINE_TEST_TOXIPROXY_URL": "http://localhost:8474",
          "SHINE_TEST_PG_CNS": "postgres://username:password@localhost:5432/database-test?sslmode=disable",
          "SHINE_TEST_PG_CNS_DIRECT": "postgres://username:password@localhost:25432/database-test?sslmode=disable",
          "SHINE_TEST_REDIS_CNS": "redis://localhost:6379",
          "SHINE_TEST_REDIS_CNS_DIRECT": "redis://localhost:26379"
        }
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "test wasm",
      "type": "shell",
      "command": "cargo test --config .cargo/wasm-test-config.toml --target wasm32-unknown-unknown ${input:wasm-projects}",
      "options": {
        "env": {
          "_RUST_LOG": "debug",
          "RUST_BACKTRACE": "full",
          "CHROMEDRIVER": "${workspaceFolder}\\target\\browser-drivers\\chromedriver-win64\\chromedriver.exe",
          "_GECKODRIVER": "${workspaceFolder}\\target\\browser-drivers\\geckodriver.exe"
        }
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "test miri",
      "type": "shell",
      "command": "cargo miri test ${input:projects}",
      "options": {
        "env": {
          "_RUST_LOG": "debug",
          "RUST_BACKTRACE": "full"
        }
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "dev environment",
      "type": "shell",
      "command": "docker compose -f services/docker-compose.yml -p shine ${input:env-task}",
      "group": "build",
      "isBackground": true
    },
    {
      "label": "start mocked services",
      "type": "shell",
      "command": "npm run mock:services",
      "options": {
        "cwd": "${workspaceFolder}/tests"
      },
      "group": "build",
      "isBackground": true
    },
    {
      "label": "run identity",
      "type": "shell",
      "command": "cargo run -p shine-identity --release -- ${input:config-stage}",
      "options": {
        "cwd": "services/identity",
        "env": {
          "RUST_BACKTRACE": "full"
        }
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "run builder",
      "type": "shell",
      "command": "cargo run -p shine-builder --release -- ${input:config-stage}",
      "options": {
        "cwd": "services/builder",
        "env": {
          "RUST_BACKTRACE": "full"
        }
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    }
  ],
  "inputs": [
    {
      "type": "pickString",
      "id": "config-stage",
      "description": "Select config (local: dev overrides on top of test; test: as used by CI)",
      "options": [
        "local",
        "test"
      ],
      "default": "local"
    },
    {
      "type": "pickString",
      "id": "projects",
      "description": "Select project",
      "options": [
        {
          "label": "all",
          "value": ""
        },
        {
          "label": "shine-builder",
          "value": "-p shine-builder"
        },
        {
          "label": "shine-identity",
          "value": "-p shine-identity"
        },
        {
          "label": "shine-infra",
          "value": "-p shine-infra"
        },
        {
          "label": "shine-infra-macros",
          "value": "-p shine-infra-macros"
        },
        {
          "label": "shine-infra-testing",
          "value": "-p shine-infra-testing"
        },
        {
          "label": "shine-core",
          "value": "-p shine-core --features tokio,validator"
        },
        {
          "label": "shine-game",
          "value": "-p shine-game"
        },
        {
          "label": "shine-game-tools",
          "value": "-p shine-game-tools"
        },
        {
          "label": "shine-test",
          "value": "-p shine-test"
        },
        {
          "label": "shine-test-macros",
          "value": "-p shine-test-macros"
        }
      ],
      "default": "asset-service"
    },
    {
      "type": "pickString",
      "id": "wasm-projects",
      "description": "Select project",
      "options": [
        {
          "label": "all",
          "value": "-p shine-core -p shine-game -p shine-test"
        },
        {
          "label": "shine-core",
          "value": "-p shine-core"
        },
        {
          "label": "shine-game",
          "value": "-p shine-game"
        },
        {
          "label": "shine-test",
          "value": "-p shine-test"
        }
      ],
      "default": "asset-service"
    },
    {
      "type": "pickString",
      "id": "env-task",
      "description": "Select env task",
      "options": [
        {
          "label": "start (rebuild)",
          "value": "up --build"
        },
        {
          "label": "start",
          "value": "up"
        },
        {
          "label": "start (with trace dashboard)",
          "value": "--profile observe up"
        },
        {
          "label": "stop",
          "value": "--profile \"*\" down"
        },
        {
          "label": "status",
          "value": "ps"
        }
      ],
      "default": "asset-service"
    }
  ]
}